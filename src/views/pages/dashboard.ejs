<%- include("../partials/header") %>

<h2 class="mb-4">Campus Dashboard</h2>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card bg-primary text-white p-3 text-center">
      <h5>Users</h5>
      <h3><%= stats.totalUsers %></h3>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-success text-white p-3 text-center">
      <h5>Total Events</h5>
      <h3><%= stats.totalEvents %></h3>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-info text-white p-3 text-center">
      <h5>Upcoming Events</h5>
      <h3><%= stats.upcomingEventsCount %></h3>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card bg-warning text-dark p-3 text-center">
      <h5>Registrations</h5>
      <h3><%= stats.totalRegistrations %></h3>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header fw-bold">Next 5 Upcoming Events</div>
      <div class="card-body">
        <table class="table table-hover">
          <thead>
            <tr>
              <th>Title</th>
              <th>Category</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% nextEvents.forEach(event => { %>
              <tr>
                <td><%= event.title %></td>
                <td><span class="badge bg-secondary"><%= event.category %></span></td>
                <td><%= new Date(event.startDate).toLocaleDateString() %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card border-primary">
      <div class="card-header bg-primary text-white fw-bold">Most Popular Event</div>
      <div class="card-body">
        <% if (popularEvent) { %>
          <h5 class="card-title"><%= popularEvent.title %></h5>
          <p class="card-text">Category: <%= popularEvent.category %></p>
          <p class="card-text">Capacity: <%= popularEvent.capacity %></p>
          <p class="fw-bold text-success">Confirmed Attendees: <%= popularEvent.confirmedCount %></p>
        <% } else { %>
          <p>No event data available.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>

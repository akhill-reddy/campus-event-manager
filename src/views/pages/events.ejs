<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Events Catalog</h2>
  <a href="#" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createEventModal">+ Create Event</a>
</div>

<!-- Search and Filter Form -->
<form action="/events" method="GET" class="row g-3 mb-4">
  <div class="col-md-5">
    <input type="text" name="search" class="form-control" placeholder="Search by title..." value="<%= search %>">
  </div>
  <div class="col-md-4">
    <select name="category" class="form-select">
      <option value="">All Categories</option>
      <% categories.forEach(cat => { %>
        <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
      <% }); %>
    </select>
  </div>
  <div class="col-md-3">
    <button type="submit" class="btn btn-secondary w-100">Filter</button>
  </div>
</form>

<!-- Events Grid -->
<div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
  <% events.forEach(evt => { %>
    <div class="col">
      <div class="card h-100 shadow-sm">
        <div class="card-body">
          <span class="badge bg-primary float-end"><%= evt.category %></span>
          <h5 class="card-title"><%= evt.title %></h5>
          <p class="card-text text-muted small"><%= evt.description %></p>
          <ul class="list-unstyled text-muted small mb-3">
            <li><strong>Date:</strong> <%= new Date(evt.startDate).toLocaleDateString() %></li>
            <li><strong>Location:</strong> <%= evt.location.building %>, <%= evt.location.room.includes('Room') ? evt.location.room : 'Room ' + evt.location.room %></li>
            <li><strong>Capacity:</strong> <%= evt.regCount %> / <%= evt.capacity %> Registered</li>
          </ul>
          <a href="/events/<%= evt._id %>" class="btn btn-sm btn-outline-primary">View Details</a>
        </div>
      </div>
    </div>
  <% }); %>
</div>

<%- include('../partials/footer') %>
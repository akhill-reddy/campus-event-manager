<%- include("../partials/header") %>

<div class="card mb-4 shadow-sm">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2><%= event.title %></h2>
      <span class="badge bg-primary fs-6"><%= event.category %></span>
    </div>
    <p class="lead"><%= event.description %></p>
    <hr>
    <div class="row">
      <div class="col-md-6">
        <p><strong>Start:</strong> <%= new Date(event.startDate).toLocaleString() %></p>
        <p><strong>End:</strong> <%= new Date(event.endDate).toLocaleString() %></p>
        <p><strong>Capacity:</strong> <%= event.capacity %></p>
      </div>
      <div class="col-md-6">
        <p><strong>Location:</strong> <%= event.location ? event.location.building : "N/A" %>, <%= event.location ? event.location.room : "" %> (<%= event.location ? event.location.campus : "" %>)</p>
        <p><strong>Tags:</strong> 
          <% if (event.tags) { %>
            <% event.tags.forEach(tag => { %>
              <span class="badge bg-light text-dark border"><%= tag %></span>
            <% }); %>
          <% } %>
        </p>
      </div>
    </div>
    <hr>
    <div class="d-flex justify-content-between">
      <a href="/events" class="btn btn-secondary">Back to Events</a>
      <form action="/events/<%= event._id %>/delete" method="POST">
        <button type="submit" class="btn btn-danger">Delete Event</button>
      </form>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>
